# Copy to .env and edit for your deployment.
# When you expose the lab on a public domain, set these so the cross-links
# between the website and SenNet point at the right place.

# Examples:
#   WEB_URL=http://bank.yourlabdomain.com
#   BANK_URL=http://banking.yourlabdomain.com
# or if you serve SenNet on a path/port:
#   WEB_URL=http://yourlabdomain.com
#   BANK_URL=http://yourlabdomain.com:8091

WEB_URL=http://localhost:8090
BANK_URL=http://localhost:8091
